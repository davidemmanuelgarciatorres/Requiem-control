# REQUIEM CONTROL — variables de entorno (plantilla, sin valores reales).
# La Fase 1 (solo interfaz) NO necesita ninguna variable.
# Copia este archivo a .env cuando lleguen las fases indicadas. Nunca subas .env a Git.

# Fase 2 — API y base de datos (solo servidor)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/requiem_control
# SESSION_SECRET=

# Fase 4 — proveedor de IA (solo servidor; nunca en el frontend)
# AI_PROVIDER=mock
# AI_PROVIDER_API_KEY=

# Fase 6 — OAuth de Google (solo servidor)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Frontend: solo variables públicas con prefijo VITE_ (nunca secretos)
# VITE_API_BASE_URL=http://localhost:8000

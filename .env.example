# REQUIEM CONTROL — variables de entorno (plantilla, sin secretos reales).
# Copia a backend/.env para desarrollo. Nunca subas .env a Git.

# --- API (Fase 2) ------------------------------------------------------------
ENVIRONMENT=development
# Rol de la API: SIN superusuario ni BYPASSRLS (la Row-Level Security debe aplicar).
DATABASE_URL=postgresql+psycopg://requiem_app:CAMBIAR@localhost:5432/requiem_control
# Rol propietario de las tablas: solo para migraciones (alembic upgrade head).
MIGRATION_DATABASE_URL=postgresql+psycopg://requiem_owner:CAMBIAR@localhost:5432/requiem_control
# En producción: true (cookies solo por HTTPS).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Orígenes del frontend autorizados a enviar peticiones que cambian estado (JSON).
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Fase 4 — proveedor de IA (solo servidor; nunca en el frontend) ----------
# mock (por defecto): resúmenes por plantilla, sin costo, marcados como simulados.
# anthropic: Claude con el SDK oficial; requiere ANTHROPIC_API_KEY (o `ant auth login`) y CONSUME CRÉDITOS.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# --- Fase 6 — OAuth de Google (solo servidor) --------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Frontend ------------------------------------------------------------------
# El servidor de Vite reenvía /api a esta dirección (no es un secreto).
# API_PROXY_TARGET=http://localhost:8000

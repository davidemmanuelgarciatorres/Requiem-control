# Copia a .env.production (NO se sube a Git) y completa. Genera contraseñas largas y únicas.
ENVIRONMENT=production
POSTGRES_PASSWORD=
OWNER_PASSWORD=
APP_PASSWORD=
COOKIE_SECURE=true
# Tu dominio con HTTPS (el mismo para la página y /api)
PUBLIC_APP_URL=https://app.tudominio.mx
ALLOWED_ORIGINS=["https://app.tudominio.mx"]

# IA (opcional): mock | anthropic | gemini
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# GEMINI_API_KEY=

# Google (opcional)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://app.tudominio.mx/api/integrations/google/callback
# INTEGRATIONS_ENCRYPTION_KEY=

# Cobros con Stripe (opcional; empieza con claves de PRUEBA sk_test_…)
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PREMIUM=
